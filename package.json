{
  "name": "youtube-audio-caster",
  "version": "1.1.0",
  "description": "Cast a YouTube video's audio to an audio-only Google speaker as a native buffered stream instead of fragile screen mirroring",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "server": "node server.js",
    "postinstall": "node scripts/fetch-ytdlp.js && node scripts/make-icon.js",
    "update-ytdlp": "node scripts/fetch-ytdlp.js",
    "icon": "node scripts/make-icon.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "YouTube Audio Caster",
  "build": {
    "appId": "com.michaelgtodd.youtube-audio-caster",
    "productName": "YouTube Audio Caster",
    "beforePack": "scripts/before-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "playlists.js",
      "renderer/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "YouTube Audio Caster"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music"
    }
  }
}
